generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

type JambRecommendedTopic {
  topic     String?
  subtopics String[]
}

type JambRecommendedTextbook {
  title       String
  author      String?
  authors     String[]
  editors     String[]
  edition     String?
  year        Int?
  publisher   String?
  location    String?
  volume      String?
  description String?
  category    String?
}

enum UserRole {
  VISITOR
  STUDENT
  PARENT
  TEACHER
  STAFF
  ADMIN
  BURSAR
  ALUMNI
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum MediaTypeName {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  PDF
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  OBJECTIVE
  SHORT_ANSWER
  ESSAY
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum TestType {
  WAEC
  JAMB
  TEST
  QUIZ
  REVISION
  ASSIGNMENT
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  ARCHIVED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  LATE
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

enum ComplaintCategory {
  COMPLAIN
  ADVICE
  FEEDBACK
}

model User {
  id                    String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                  String?
  email                 String                 @unique
  password              String?
  avatarUrl             String?
  phone                 String?
  role                  UserRole               @default(STUDENT)
  status                UserStatus             @default(ACTIVE)
  schoolMemberships     SchoolUser[]
  homeroomClasses       SchoolClass[]          @relation("ClassTeacher")
  createdMedia          Media[]                @relation("UploadedMedia")
  sentMessages          ChatMessage[]          @relation("SentMessages")
  receivedMessages      ChatMessage[]          @relation("ReceivedMessages")
  studyGroupMemberships StudyGroupMember[]
  submissions           AssignmentSubmission[] @relation("StudentSubmissions")
  complaints            Complaint[]
  performanceMetrics    PerformanceMetric[]
  rankingSnapshots      RankingSnapshot[]
  dailyProgresses       DailyProgress[]
  alumniProfiles        AlumniProfile[]
  jambResults           JambResult[]           @relation("UserJambResults")
  seenQuestions         QuestionSeen[]         @relation("UserSeenQuestions")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model School {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  slug               String              @unique
  motto              String?
  logoUrl            String?
  websiteUrl         String?
  members            SchoolUser[]
  classes            SchoolClass[]
  subjects           Subject[]
  departments        Department[]
  subjectOfferings   SubjectOffering[]
  media              Media[]
  tests              Test[]
  assignments        Assignment[]
  announcements      Announcement[]
  fees               SchoolFee[]
  complaints         Complaint[]
  rankings           RankingSnapshot[]
  performanceMetrics PerformanceMetric[]
  alumni             AlumniProfile[]
  studyGroups        StudyGroup[]
  chatThreads        ChatThread[]
  topicCoverages     TopicCoverage[]
  studentSets        StudentSet[]
  academicSessions   AcademicSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model SchoolClass {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  school          School            @relation(fields: [schoolId], references: [id])
  schoolId        String            @db.ObjectId
  sessionId       String?           @db.ObjectId
  session         AcademicSession?  @relation("SessionClasses", fields: [sessionId], references: [id])
  name            String
  level           String?
  year            String?
  department      String?
  classTeacher    User?             @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  classTeacherId  String?           @db.ObjectId
  students        SchoolUser[]      @relation("ClassMembers")
  subjectOfferings SubjectOffering[]
  tests           Test[]
  assignments     Assignment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([schoolId, name, year])
  @@index([schoolId, name])
}

model SchoolUser {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  user         User               @relation(fields: [userId], references: [id])
  userId       String             @db.ObjectId
  school       School             @relation(fields: [schoolId], references: [id])
  schoolId     String             @db.ObjectId
  role         UserRole
  status       UserStatus         @default(ACTIVE)
  classId      String?            @db.ObjectId
  class        SchoolClass?       @relation("ClassMembers", fields: [classId], references: [id])
  setId        String?            @db.ObjectId
  set          StudentSet?        @relation("SetStudents", fields: [setId], references: [id])
  entryLevel   String?            // e.g. "JSS1", "JSS3", "SS1" (level student joined the school)
  entryYear    Int?               // e.g. 2014, 2016 (year student joined)
  parentLinks  ParentStudentLink[] @relation("ParentLink")
  studentLinks ParentStudentLink[] @relation("StudentLink")
  attempts     AssessmentAttempt[] @relation("StudentAttempts")
  termResults  TermResult[]
  promotions   StudentPromotion[]
  subjectEnrollments StudentSubjectEnrollment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([schoolId, userId])
  @@index([schoolId, role])
}

model ParentStudentLink {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  parent    SchoolUser @relation("ParentLink", fields: [parentId], references: [id])
  parentId  String     @db.ObjectId
  student   SchoolUser @relation("StudentLink", fields: [studentId], references: [id])
  studentId String     @db.ObjectId
  createdAt DateTime   @default(now())

  @@unique([parentId, studentId])
}

model Subject {
  id                   String                 @id @default(auto()) @map("_id") @db.ObjectId
  school               School                 @relation(fields: [schoolId], references: [id])
  schoolId             String                 @db.ObjectId
  name                 String
  code                 String?
  departmentIds        String[]               @db.ObjectId
  departments          Department[]           @relation(fields: [departmentIds], references: [id])
  parentSubjectId      String?                @db.ObjectId
  parentSubject        Subject?               @relation("SubSubjects", fields: [parentSubjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subSubjects          Subject[]              @relation("SubSubjects")
  topics               Topic[]
  media                Media[]
  offerings            SubjectOffering[]
  topicCoverages       TopicCoverage[]
  recommendedTextbooks RecommendedTextbook[]
  studentEnrollments   StudentSubjectEnrollment[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([schoolId, name])
}

model TopicCoverage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id])
  schoolId    String   @db.ObjectId
  subject     Subject  @relation(fields: [subjectId], references: [id])
  subjectId   String   @db.ObjectId
  week        Int
  topic       String
  subtopic    String?
  covered     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectId, week])
  @@index([schoolId, subjectId])
}

model Department {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  school     School    @relation(fields: [schoolId], references: [id])
  schoolId   String    @db.ObjectId
  name       String
  subjectIds String[]  @db.ObjectId
  subjects   Subject[] @relation(fields: [subjectIds], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([schoolId, name])
}

model SubjectOffering {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  school    School      @relation(fields: [schoolId], references: [id])
  schoolId  String      @db.ObjectId
  subject   Subject     @relation(fields: [subjectId], references: [id])
  subjectId String      @db.ObjectId
  class     SchoolClass @relation(fields: [classId], references: [id])
  classId   String      @db.ObjectId
  createdAt DateTime    @default(now())

  @@unique([classId, subjectId])
  @@index([schoolId, subjectId])
}

model Topic {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  subject      Subject    @relation(fields: [subjectId], references: [id])
  subjectId    String     @db.ObjectId
  // sectionLabel groups topics into sections (e.g. "Section I: Physical Chemistry"). null = uncategorised.
  sectionLabel String?
  name         String
  description  String?
  sortOrder    Int        @default(0)
  subtopics    SubTopic[]
  questions    Question[]
  tests        Test[]
  media        Media[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([subjectId, name])
}

model SubTopic {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  topic       Topic    @relation(fields: [topicId], references: [id])
  topicId     String   @db.ObjectId
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([topicId, name])
  @@index([topicId])
}

model RecommendedTextbook {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  subject   Subject  @relation(fields: [subjectId], references: [id])
  subjectId String   @db.ObjectId
  title     String
  authors   String[]   // one or more author strings
  edition   String?
  year      Int?
  publisher String?
  createdAt DateTime @default(now())

  @@index([subjectId])
}

model MediaType {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        MediaTypeName @unique
  description String?
  media       Media[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Media {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  school       School     @relation(fields: [schoolId], references: [id])
  schoolId     String     @db.ObjectId
  title        String
  description  String?
  kind         MediaTypeName
  mediaType    MediaType  @relation(fields: [mediaTypeId], references: [id])
  mediaTypeId  String     @db.ObjectId
  fileUrl      String
  thumbnailUrl String?
  subject      Subject?   @relation(fields: [subjectId], references: [id])
  subjectId    String?     @db.ObjectId
  topic        Topic?     @relation(fields: [topicId], references: [id])
  topicId      String?    @db.ObjectId
  uploadedBy   User       @relation("UploadedMedia", fields: [uploadedById], references: [id])
  uploadedById String     @db.ObjectId
  isPublic     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([schoolId, subjectId, kind])
}

model Question {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  year           Int?
  questionNumber Int?
  pageNumber     Int?
  pdfName        String?
  examType       String?         // "jamb", "waec", "neco", etc.
  subject        String?
  topicName      String?
  subtopicName   String?
  topic          Topic?          @relation(fields: [topicId], references: [id])
  topicId        String?         @db.ObjectId
  type           QuestionType    @default(MULTIPLE_CHOICE)
  difficulty     DifficultyLevel @default(MEDIUM)
  prompt         String
  explanation    String?
  note           String?
  passage       String?
  context       String?
  needsRescan    Boolean         @default(false)
  aiReviewed     Boolean         @default(false)
  needsImage     Boolean         @default(false)
  image          Json?
  imageUrl       String?
  option1        String?
  option2        String?
  option3        String?
  option4        String?
  option5        String?
  answer         String?
  options        QuestionOption[]
  testLinks      TestQuestion[]
  answers        AttemptAnswer[]
  seenBy         QuestionSeen[]         @relation("QuestionSeenBy")
  jambResultAnswers JambResultAnswer[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model QuestionOption {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  question   Question @relation(fields: [questionId], references: [id])
  questionId String   @db.ObjectId
  label      String
  text       String
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
}

model Test {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  school          School            @relation(fields: [schoolId], references: [id])
  schoolId        String            @db.ObjectId
  topic           Topic?            @relation(fields: [topicId], references: [id])
  topicId         String?           @db.ObjectId
  class           SchoolClass?      @relation(fields: [classId], references: [id])
  classId         String?           @db.ObjectId
  title           String
  slug            String?
  type            TestType
  status          TestStatus        @default(DRAFT)
  durationMinutes Int?
  totalMarks      Int               @default(0)
  passMark        Int               @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  isPublished     Boolean           @default(false)
  questions       TestQuestion[]
  attempts        AssessmentAttempt[] @relation("TestAttempts")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([schoolId, status])
}

model TestQuestion {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  test       Test     @relation(fields: [testId], references: [id])
  testId     String   @db.ObjectId
  question   Question @relation(fields: [questionId], references: [id])
  questionId String   @db.ObjectId
  sequence   Int
  points     Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([testId, questionId])
}

model AssessmentAttempt {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  test        Test             @relation("TestAttempts", fields: [testId], references: [id])
  testId      String           @db.ObjectId
  student     SchoolUser       @relation("StudentAttempts", fields: [studentId], references: [id])
  studentId   String           @db.ObjectId
  score       Int              @default(0)
  totalScore  Int              @default(0)
  startedAt   DateTime         @default(now())
  submittedAt DateTime?
  status      SubmissionStatus @default(DRAFT)
  answers     AttemptAnswer[]

  @@index([testId, studentId])
}

model AttemptAnswer {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id])
  attemptId      String            @db.ObjectId
  question       Question          @relation(fields: [questionId], references: [id])
  questionId     String            @db.ObjectId
  selectedOption String?
  textAnswer     String?
  isCorrect      Boolean?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([attemptId, questionId])
}

model QuestionSeen {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user       User     @relation("UserSeenQuestions", fields: [userId], references: [id])
  userId     String   @db.ObjectId
  question   Question @relation("QuestionSeenBy", fields: [questionId], references: [id])
  questionId String   @db.ObjectId
  seenAt     DateTime @default(now())
  seenCount  Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId, seenAt])
}

// One record represents one submitted JAMB practice/exam attempt. Individual
// question outcomes are kept separately so every attempted question is auditable.
model JambResult {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  user            User               @relation("UserJambResults", fields: [userId], references: [id])
  userId          String             @db.ObjectId
  submissionKey   String?            @unique
  subject         String?
  examYear        Int?
  score           Int                @default(0)
  totalQuestions  Int                @default(0)
  correctCount    Int                @default(0)
  incorrectCount  Int                @default(0)
  submittedAt     DateTime           @default(now())
  questionResults JambResultAnswer[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, submittedAt])
}

model JambResultAnswer {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  result          JambResult @relation(fields: [resultId], references: [id])
  resultId        String     @db.ObjectId
  question        Question   @relation(fields: [questionId], references: [id])
  questionId      String     @db.ObjectId
  selectedAnswer  String?
  correctAnswer   String?
  isCorrect       Boolean
  pointsAwarded   Int        @default(0)
  createdAt       DateTime   @default(now())

  @@unique([resultId, questionId])
  @@index([questionId])
}

model Assignment {
  id          String                 @id @default(auto()) @map("_id") @db.ObjectId
  school      School                 @relation(fields: [schoolId], references: [id])
  schoolId    String                 @db.ObjectId
  class       SchoolClass?           @relation(fields: [classId], references: [id])
  classId     String?                @db.ObjectId
  title       String
  description String?
  dueDate     DateTime?
  createdBy   String                 @db.ObjectId
  submissions AssignmentSubmission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model AssignmentSubmission {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  assignmentId String           @db.ObjectId
  student      User             @relation("StudentSubmissions", fields: [studentId], references: [id])
  studentId    String           @db.ObjectId
  content      String?
  fileUrl      String?
  status       SubmissionStatus @default(SUBMITTED)
  score        Int?
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
}

model StudyGroup {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  school      School             @relation(fields: [schoolId], references: [id])
  schoolId    String             @db.ObjectId
  name        String
  description String?
  createdBy   String             @db.ObjectId
  members     StudyGroupMember[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model StudyGroupMember {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  group     StudyGroup  @relation(fields: [groupId], references: [id])
  groupId   String      @db.ObjectId
  user      User        @relation(fields: [userId], references: [id])
  userId    String      @db.ObjectId
  role      String      @default("member")
  joinedAt  DateTime    @default(now())

  @@unique([groupId, userId])
}

model ChatThread {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  school    School        @relation(fields: [schoolId], references: [id])
  schoolId  String        @db.ObjectId
  name      String?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  thread     ChatThread @relation(fields: [threadId], references: [id])
  threadId   String     @db.ObjectId
  sender     User       @relation("SentMessages", fields: [senderId], references: [id])
  senderId   String     @db.ObjectId
  receiver   User?      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId String?    @db.ObjectId
  content    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Announcement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id])
  schoolId  String   @db.ObjectId
  title     String
  body      String
  createdBy String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolFee {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  school    School    @relation(fields: [schoolId], references: [id])
  schoolId  String    @db.ObjectId
  studentId String    @db.ObjectId
  title     String
  amount    Float
  status    FeeStatus @default(PENDING)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Complaint {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  school    School            @relation(fields: [schoolId], references: [id])
  schoolId  String            @db.ObjectId
  user      User              @relation(fields: [userId], references: [id])
  userId    String            @db.ObjectId
  category  ComplaintCategory @default(FEEDBACK)
  title     String
  message   String
  status    String            @default("open")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model DailyProgress {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @db.ObjectId
  solvedToday Int      @default(0)
  quizzesDone Int      @default(0)
  accuracy    Float    @default(0)
  streak      Int      @default(0)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PerformanceMetric {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id])
  schoolId    String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @db.ObjectId
  subject     String
  score       Float    @default(0)
  average     Float    @default(0)
  growthIndex Float    @default(0)
  speedIndex  Float    @default(0)
  coverage    Float    @default(0)
  recordedAt  DateTime @default(now())
}

model RankingSnapshot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id])
  schoolId  String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  role      UserRole
  rank      Int
  score     Float    @default(0)
  label     String?
  createdAt DateTime @default(now())
}

model AlumniProfile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  school         School   @relation(fields: [schoolId], references: [id])
  schoolId       String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id])
  userId         String   @db.ObjectId
  graduationYear Int?
  achievement    String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  model     String
  operation String
  userId    String
  recordId  String
  changes   Json?
  timestamp DateTime @default(now())

  @@index([model, recordId])
  @@index([userId, timestamp])
  @@index([timestamp])
}

// ==============================================================================
// STUDENT SET / COHORT & PROMOTION MANAGEMENT
// ==============================================================================

enum SetStatus {
  ACTIVE
  GRADUATED
  ARCHIVED
}

enum TermName {
  FIRST_TERM
  SECOND_TERM
  THIRD_TERM
}

enum TermStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum ResultStatus {
  PASS
  FAIL
  PENDING
}

enum PromotionDecision {
  PROMOTED
  REPEAT
  GRADUATED
  PENDING
}

model StudentSet {
  id                     String             @id @default(auto()) @map("_id") @db.ObjectId
  school                 School             @relation(fields: [schoolId], references: [id])
  schoolId               String             @db.ObjectId
  name                   String             // e.g. "Class of 2020" or "Set of 2020"
  entryYear              Int                // e.g. 2014
  expectedGraduationYear Int                // e.g. 2020
  currentLevel           String             @default("JSS1") // e.g. "JSS1", "JSS2", "JSS3", "SS1", "SS2", "SS3", "GRADUATED"
  status                 SetStatus          @default(ACTIVE)
  students               SchoolUser[]       @relation("SetStudents")
  promotions             StudentPromotion[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, entryYear])
}

model AcademicSession {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  school      School             @relation(fields: [schoolId], references: [id])
  schoolId    String             @db.ObjectId
  name        String             // e.g. "2014/2015", "2019/2020"
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean            @default(false)
  terms       AcademicTerm[]
  classes     SchoolClass[]      @relation("SessionClasses")
  promotions  StudentPromotion[]
  studentEnrollments StudentSubjectEnrollment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([schoolId, name])
}

model AcademicTerm {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  sessionId   String          @db.ObjectId
  name        TermName        // FIRST_TERM, SECOND_TERM
  status      TermStatus      @default(UPCOMING)
  startDate   DateTime?
  endDate     DateTime?
  termResults TermResult[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([sessionId, name])
}

model TermResult {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  term       AcademicTerm @relation(fields: [termId], references: [id])
  termId     String       @db.ObjectId
  student    SchoolUser   @relation(fields: [studentId], references: [id])
  studentId  String       @db.ObjectId
  status     ResultStatus @default(PENDING) // PASS or FAIL
  totalScore Float?
  average    Float?
  remarks    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([termId, studentId])
}

model StudentPromotion {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  student        SchoolUser        @relation(fields: [studentId], references: [id])
  studentId      String            @db.ObjectId
  set            StudentSet        @relation(fields: [setId], references: [id])
  setId          String            @db.ObjectId
  session        AcademicSession   @relation(fields: [sessionId], references: [id])
  sessionId      String            @db.ObjectId
  fromLevel      String            // e.g. "JSS1"
  toLevel        String            // e.g. "JSS2" or "GRADUATED"
  firstTermPass  Boolean           @default(false)
  secondTermPass Boolean           @default(false)
  thirdTermPass  Boolean           @default(false)
  decision       PromotionDecision @default(PENDING) // PROMOTED, REPEAT, GRADUATED
  promotedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([studentId, sessionId])
}

model StudentSubjectEnrollment {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  student     SchoolUser       @relation(fields: [studentId], references: [id])
  studentId   String           @db.ObjectId
  session     AcademicSession? @relation(fields: [sessionId], references: [id])
  sessionId   String?          @db.ObjectId
  subject     Subject          @relation(fields: [subjectId], references: [id])
  subjectId   String           @db.ObjectId
  isBorrowed  Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@unique([studentId, subjectId, sessionId])
  @@index([studentId, sessionId])
}


